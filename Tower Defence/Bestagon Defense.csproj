<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net7.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BestagonDefense</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Editor\**" />
    <Compile Remove="Gameplay\DiscordController.cs" />
    <Compile Remove="Gameplay\Controls\**" />
    <Compile Remove="MaterialLibrary\**" />
    <Compile Remove="Modules\_NeedRebalance\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Editor\**" />
    <EmbeddedResource Remove="Gameplay\Controls\**" />
    <EmbeddedResource Remove="MaterialLibrary\**" />
    <EmbeddedResource Remove="Modules\_NeedRebalance\**" />
  </ItemGroup>
</Project>